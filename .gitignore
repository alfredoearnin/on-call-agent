# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js
/.next/
/out/
next-env.d.ts

# Production
/build

# Debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
# Rotated logs escape *.log (e.g. mcp.log.1), and MCP server logs are exactly
# where a PAT or auth header lands on the next error.
*.log.*
/logs/

# Secrets and local env — NEVER commit real env files (fintech rule).
# Only .env.example (placeholders) is tracked.
.env
.env.local
.env.*.local
.env.development
.env.production
# scripts/setup.sh stages credential edits here before an atomic rename. It is
# removed on exit, including on Ctrl-C, but an ignore keeps a kill -9 harmless.
.env.local.tmp

# OS
.DS_Store
*.pem
# iCloud renames a file it cannot merge to "name 2.ts" rather than reporting a
# conflict, and this repo lives under ~/Documents. The copy is byte-identical,
# so a stray `git add -A` commits a second copy of a module that nothing
# imports — a dead file that reads as live, and the wrong one to edit.
#
# Both forms are needed: a duplicate of `.env` is named `.env 2`, with no
# trailing dot, and that is the copy that would carry real credentials.
#
# These match on filename shape, not origin, so a deliberate "Phase 2.md" would
# be hidden too. `git status --ignored` shows it; `git add -f` commits it.
* [2-9].*
* [2-9]

# Local editor / agent config. Whole-directory: everything here today is
# personal (a dev-server launch config, an agent permission list). If shared
# config ever lands here — a pre-commit hook the team is meant to inherit —
# negate that file, or clones will silently lack it.
.claude/

# TypeScript
*.tsbuildinfo

# Prisma
# NOTE: the SQLite "memory" DB (prisma/oncall.db) is intentionally COMMITTED
# so a fresh clone inherits the shared incident/recommendation history.
# Ignore only the transient SQLite sidecar files.
prisma/oncall.db-journal
prisma/oncall.db-wal
prisma/oncall.db-shm

# Scheduler runtime lock
.sync.lock
