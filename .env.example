# =============================================================================
# On-call Ops Dashboard — environment template
# Copy to .env.local (secrets) and .env (DATABASE_URL for the Prisma CLI).
# `bash scripts/install.sh` does this for you. NEVER commit real values.
# =============================================================================

# --- Database (non-secret) ---------------------------------------------------
# SQLite committed "memory" DB. Path is resolved relative to prisma/schema.prisma.
DATABASE_URL="file:./oncall.db"

# --- Demo mode ---------------------------------------------------------------
# When true (default), ingestion uses bundled sample data so the dashboard works
# with zero credentials. Set to false once real API keys are configured below.
DEMO_MODE="true"

# --- Team / analysis config (mirrors the agent prompt in agents/) -----------------------------
TEAM_TAG="team:l2-peng-growth"
TEAM_LABEL="Growth Team"
TIMEZONE="America/Los_Angeles"

# --- Datadog (read) ----------------------------------------------------------
# Site matches app.datadoghq.com (US1). Change for EU/US3/US5 etc.
DD_SITE="datadoghq.com"
DD_API_KEY=""
DD_APP_KEY=""
# DD_APPLICATION_KEY is accepted as an alias for DD_APP_KEY.
# Use underscores, NOT hyphens (DD-API-KEY is not a valid env var name).

# --- Datadog (write) — ONLY used by the guarded "Apply suggestion" feature ----
# Keep separate from the read key (least privilege). Leave APPLY_ENABLED=false
# unless you intend to let the dashboard edit real monitors.
APPLY_ENABLED="false"
DD_APP_KEY_WRITE=""

# --- incident.io (read) ------------------------------------------------------
INCIDENT_IO_API_KEY=""

# --- Jira (read, optional — vulnerabilities) ---------------------------------
JIRA_BASE_URL="https://earnin.atlassian.net"
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_VULN_FILTER_ID="15295"

# --- Sync API guard (for a future scheduler / Vercel Cron) -------------------
CRON_SECRET=""

# --- Operator label recorded in the apply + trigger audit trails -------------
OPERATOR_NAME="local-operator"

# --- Cursor Automations: schedule (non-secret) -------------------------------
# The slot the EARLIER cloud automation (health check) runs in, used to decide
# whether today's run is merely pending or actually overdue. Expressed in its own
# zone, NOT TIMEZONE, and set to run AFTER the handoff so the closing week is
# complete before it is frozen.
#
# The zone is UTC-6 with no DST. Cursor labels the slot "CST" and holds it fixed:
# scheduled `Daily refresh` commits land in a 16:08-16:18 UTC band, i.e. ~10 min
# after a 16:00 UTC slot, not ~70 min after a 15:00 UTC one. America/Mexico_City
# expresses that exactly and keeps the slot pinned to the handoff's own zone.
#
# Grace spans BOTH automations rather than one run's latency: the dashboard
# refresh runs an hour after this slot, so evidence can arrive ~80 min in.
AUTOMATION_HOUR="12"
AUTOMATION_MINUTE="0"
AUTOMATION_TIMEZONE="America/Mexico_City"
AUTOMATION_GRACE_MINUTES="180"

# --- The on-call handoff: the real boundary of a week ------------------------
# When the rotation changes hands. NOT midnight in TIMEZONE: a week cut at
# midnight PT ends ~10h before the Tuesday 11:00 Mexico City handoff, which
# charges every Tuesday-morning page to the primary who was not on call yet.
# Mexico City has had no DST since 2022, so this is a fixed 17:00 UTC year-round.
# Luxon weekday: Mon=1 ... Sun=7.
HANDOFF_WEEKDAY="2"
HANDOFF_HOUR="11"
HANDOFF_MINUTE="0"
HANDOFF_TIMEZONE="America/Mexico_City"

# --- Cursor Automations: re-run triggers (Settings -> Cloud automations) ------
# SECRETS - .env.local only. Never commit these, never paste them into a chat,
# a PR, or a terminal command, and never log them.
#
# To get them: open the automation in Cursor, add a *Webhook trigger*, then SAVE.
# Cursor generates the URL and the API key only after the automation is saved.
# Leave them empty and the Re-run buttons stay disabled; everything else works.
CURSOR_HEALTH_CHECK_WEBHOOK_URL=""
CURSOR_HEALTH_CHECK_API_KEY=""
CURSOR_DASHBOARD_REFRESH_WEBHOOK_URL=""
CURSOR_DASHBOARD_REFRESH_API_KEY=""

# Header the API key is sent in. Cursor's docs do not name it, so it is
# configurable: if a trigger returns 401, try X-Api-Key, x-cursor-api-key, or
# Authorization with CURSOR_WEBHOOK_AUTH_SCHEME="Bearer".
CURSOR_WEBHOOK_AUTH_HEADER="x-api-key"
CURSOR_WEBHOOK_AUTH_SCHEME=""

# Non-secret cursor.com links shown on Settings (blank = built-in defaults).
CURSOR_HEALTH_CHECK_URL=""
CURSOR_DASHBOARD_REFRESH_URL=""
